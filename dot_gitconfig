[user]
	email = RBastianini@users.noreply.github.com
	name = Riccardo Bastianini
[core]
	editor = vim
	pager = delta --pager='ov -F --header 3'
	diff = delta --features ov-diff
	log  = delta --features ov-log
[interactive]
	diffFilter = delta --color-only --features=interactive
[delta]
	navigate = true
	features = decorations
[delta "ov-diff"]
    pager=ov -F --section-delimiter '^(commit|added:|removed:|renamed:|Δ)' --section-header --pattern '•'

[delta "ov-log"]
    pager=ov -F --section-delimiter '^commit' --section-header-num 3
[merge]
	conflictsyle = diff3
[diff]
	colorMoved = default
[color "diff-highlight"]
	oldNormal = red bold
	oldHighlight = red bold 52
	newNormal = green bold
	newHighlight = green bold 22
[advice]
	statusHints = false
[alias]
	stash-all = stash save --include-untracked
	please = push --force-with-lease
	also-commit = commit --amend --no-edit
	reword = commit --amend -e
[diff]
	mnemonicprefix = true
[pull]
	rebase = false
[cola]
	spellcheck = false
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[push]
	autoSetupRemote = true
[commit]
	sort = -committerdate
[help]
	autocorrect = prompt
